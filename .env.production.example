# Copy this to `.env` (same directory as docker-compose.prod.yml) on the
# production server and fill in the real values. This file itself is safe
# to commit - it holds no secrets. `.env` is gitignored - never commit it.

# MongoDB Atlas connection string, with the database name added after the
# host and before the query string, e.g.:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/novamax_erp?retryWrites=true&w=majority
MONGO_URI=

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CLIENT_URL=https://erp.novamaxpharma.com
NEXT_PUBLIC_API_URL=https://erp.novamaxpharma.com/api

# Optional - email delivery for overdue-invoice alerts. Leave blank to log
# emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NovaMax ERP <no-reply@novamaxpharma.com>
