PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/novamax_erp
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Optional - email delivery for overdue-invoice alerts. If SMTP_HOST is
# left unset, emails are composed but not sent (logged to the console
# instead), so the app works fully without these configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NovaMax ERP <no-reply@novamaxpharma.com>
